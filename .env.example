# Copy to .env (gitignored) and adjust. Names and defaults follow the reference project.
# Compose only reads it when passed explicitly:
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d

# --- MySQL ---
# Host the Go programs connect to: localhost for `go run`, mysql inside Compose.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=catalog
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root
# Port published on your machine. If you change it, set MYSQL_PORT to match for `go run`.
MYSQL_HOST_PORT=3306
# database/sql pool size. Set to 1 under load to watch requests queue for a connection.
DB_MAX_OPEN_CONNS=16

# --- Redis (cache) ---
# Host the Go programs connect to: localhost for `go run`, redis inside Compose.
REDIS_HOST=localhost
REDIS_PORT=6379
# Port published on your machine. Change it (e.g. 6380) if a local redis-server
# already listens on 6379, or `make up` fails with "address already in use".
# If you change it, set REDIS_PORT to match for `go run`.
REDIS_HOST_PORT=6379
# How long the reader keeps a cached item (Go duration: 10m, 30s, 1h30m).
CACHE_TTL=10m

# --- Services ---
WRITER_PORT=8080
READER_PORT=8081
