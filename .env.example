# Copy to .env (gitignored) and adjust.
# Compose only reads it when passed explicitly:
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d

# --- MySQL ---
# Host the Go programs connect to: localhost for `go run`, mysql inside Compose.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=catalog
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root
# Port published on your machine. If you change it, set MYSQL_PORT to match for `go run`.
MYSQL_HOST_PORT=3306
# database/sql pool size. Set to 1 under load to watch requests queue for a connection.
DB_MAX_OPEN_CONNS=16

# --- Redis (cache) ---
# Host the Go programs connect to: localhost for `go run`, redis inside Compose.
REDIS_HOST=localhost
REDIS_PORT=6379
# Port published on your machine. Change it (e.g. 6380) if a local redis-server
# already listens on 6379, or `make up` fails with "address already in use".
# If you change it, set REDIS_PORT to match for `go run`.
REDIS_HOST_PORT=6379
# How long the reader keeps a cached item (Go duration: 10m, 30s, 1h30m).
CACHE_TTL=10m
# How long a reader that missed may hold the right to fill an item (Go duration).
# Only matters when that reader dies or stalls: nobody fills the item until it expires.
CACHE_LEASE_TTL=2s

# --- Services ---
WRITER_PORT=8080
READER_PORT=8081
INVALIDATOR_PORT=8082

# --- Kafka ---
# Port published on your machine, for `go run` and CLI tools. Containers use kafka:9092.
KAFKA_HOST_PORT=9092
# Kafka Connect REST API on your machine (register and inspect connectors with curl).
CONNECT_HOST_PORT=8083

# Where the invalidator reads change events. Containers use kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=cdc.catalog.items
KAFKA_GROUP=cache-invalidator